{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A Project",
  "type": "object",
  "properties": {
    "published": {
      "type": "boolean",
      "description": "false 代表不在網站上顯示。展示順序由 duration 依規則自動計算，不需要人工清單。"
    },
    "name": { "type": "string" },
    "duration": { "type": "string" },
    "contributors": {
      "type": "array",
      "items": { "type": ["string", "null"] }
    },
    "link": { "type": "string" },
    "brief_introduction": { "type": ["string","null"] },
    "introduction": { "type": "string" }
  },
  "required": [
    "published",
    "name",
    "duration",
    "contributors",
    "brief_introduction",
    "introduction"
  ]
}
